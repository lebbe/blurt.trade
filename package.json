{
  "name": "blurt.trade",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-isolation=none \"test/*.test.ts\"",
    "e2e": "node --test --test-isolation=none \"test/e2e/*.test.ts\"",
    "a11y": "node --test \"test/a11y/*.test.ts\"",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "qa": "npm run lint && npm run typecheck && oxfmt --check src test && npm test && npm run a11y && npm run e2e",
    "dev": "node --env-file-if-exists=.env --watch-path=src --watch-path=db src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env db/migrate.ts",
    "check-config": "node --env-file-if-exists=.env src/config.ts",
    "vapid-keys": "node src/vapid.ts",
    "prefetch-model": "node --env-file-if-exists=.env src/embeddings.ts",
    "deploy": "bash docker/deploy.sh",
    "typecheck": "tsc -p ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@napi-rs/canvas": "^1.1.1",
    "@node-rs/argon2": "^2.2.2",
    "@preact/signals": "^2.11.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "htm": "^3.1.1",
    "jose": "^6.2.17",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.1",
    "preact": "^11.2.0",
    "preact-hook-signal-htm-bundle": "^3.1.0",
    "preact-render-to-string": "^6.8.3",
    "sharp": "^0.35.5",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.11.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
