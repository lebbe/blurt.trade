# Copy to docker/.env (gitignored) and fill in. `npm run deploy` copies it to ~/blurt/.env on the server.
# Keep it private.

# user@host for ssh, e.g. lebbe@blurt.trade. Used by the deploy script only.
DEPLOY_HOST=

# openssl rand -hex 24   (hex, so it is safe inside the database URL)
POSTGRES_PASSWORD=
# openssl rand -base64 48   (changing it logs everyone out)
JWT_SECRET=

# Optional: a webhook that gets {"text": "..."} on crashes and 5xx spikes.
ALERT_WEBHOOK_URL=
