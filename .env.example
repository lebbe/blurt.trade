# Local development environment. Copy to .env and fill in any overrides.
# The development database defaults are configured by db/setup-wsl.sh.

CONTACT_REPO_URL=https://github.com/lebbe/blurt.trade

# Push notifications are off unless both are set. Make a pair with: npm run vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Live updates LISTEN straight to PostgreSQL (not PgBouncer); defaults to the local 5433.
# LISTEN_DATABASE_URL=postgres://blurt:blurt@localhost:5433/blurt
