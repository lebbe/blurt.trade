# blurt.trade production environment. Copy to /etc/blurt/blurt.env (owner root, group blurt,
# mode 0640) and fill in the secrets. Never commit the real file.
# Every variable is described in docs/deploy.md, Environment.
# Check it with: sudo -u blurt node --env-file=/etc/blurt/blurt.env src/config.ts

NODE_ENV=production
PORT=3000
# Caddy on the same machine is the one proxy in front of the app.
TRUST_PROXY=1

# openssl rand -base64 48   (changing it logs everyone out)
JWT_SECRET=

# The app, through PgBouncer (transaction pooling) on 6432.
DATABASE_URL=postgres://blurt:CHANGE_ME@127.0.0.1:6432/blurt
# Migrations, straight to PostgreSQL on 5432 (they need a session advisory lock).
MIGRATION_DATABASE_URL=postgres://blurt:CHANGE_ME@127.0.0.1:5432/blurt
# Optional: a streaming read replica, through PgBouncer. Unset reads from the primary.
# DATABASE_READ_URL=postgres://blurt:CHANGE_ME@127.0.0.1:6432/blurt_read
# At or below PgBouncer's default_pool_size, split between app processes.
DB_POOL_SIZE=20
# READ_YOUR_WRITES_SECONDS=10

# false: deploy/deploy.sh runs migrations once, before restarting the app.
MIGRATE_ON_START=false

# Where the embedding model is cached; outside node_modules so `npm ci` keeps it.
MODEL_CACHE_DIR=/var/lib/blurt/models

# Rate limits: RATE_LIMIT_SCALE multiplies every burst (0 switches limits off), and
# RATE_LIMIT_<NAME>=burst/period overrides one, e.g. RATE_LIMIT_LOGIN_IP=10/10m.
# RATE_LIMIT_SCALE=1

# Optional: a webhook that gets {"text": "..."} when the app crashes or 5xx responses spike
# (Slack, Mattermost, Google Chat, or an ntfy.sh topic). Treat it as a secret.
# ALERT_WEBHOOK_URL=
# How many 5xx responses within 5 minutes count as a spike.
# ALERT_5XX_THRESHOLD=10

# How to reach the site's owner, shown on /about, /terms and /privacy (both public).
# The GitHub repository, for public issues and private vulnerability reports:
# CONTACT_REPO_URL=https://github.com/<owner>/<repo>
# For what shouldn't be public (security, illegal content, data requests). A role address.
# CONTACT_EMAIL=
